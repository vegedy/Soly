              },
              {
                "pattern": "\\s"
              }
            ]
          }
        },
        "measurement_kind": {
          "const": "change"
        }
      },
      "required": [
        "entity_id",
        "state",
        "ts",
        "measurement_kind"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "entity_id": {
