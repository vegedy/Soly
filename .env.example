# Local development examples only. Copy to .env; never commit real credentials.
COMPOSE_PROJECT_NAME=soly
SOLY_KAFKA_PORT=9092
SOLY_POSTGRES_PORT=5432
SOLY_FLINK_PORT=8081
SOLY_KAFKA_TOPIC=soly-infra-smoke
SOLY_KAFKA_PARTITIONS=1
SOLY_POSTGRES_DB=soly
SOLY_POSTGRES_USER=soly
SOLY_POSTGRES_PASSWORD=soly-local-example-only
SOLY_KAFKA_HEAP=-Xms512m -Xmx512m
SOLY_JOBMANAGER_MEMORY=1024m
SOLY_TASKMANAGER_MEMORY=2048m
SOLY_TASK_SLOTS=2
SOLY_STACK_TIMEOUT=180
